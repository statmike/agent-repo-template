{
  "$comment": "Project-level Claude Code configuration. Shares canonical rules, skills, and polyglot hook scripts with .agents/ so behavior stays identical across Claude Code and Antigravity. Personal per-repo overrides go in .claude/settings.local.json (gitignored).",
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(python -m pip:*)",
      "Bash(python3 -m pip:*)",
      "Bash(python -m venv:*)",
      "Bash(python3 -m venv:*)",
      "Bash(virtualenv:*)",
      "Bash(conda:*)",
      "Bash(mamba:*)",
      "Bash(poetry:*)",
      "Bash(pipenv:*)",
      "Bash(pdm:*)",
      "Bash(gcloud auth activate-service-account:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/guard_uv.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/guard_secrets.py\""
          }
        ]
      }
    ]
  }
}
